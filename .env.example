# cp .env.example .env.local  (Bun loads .env.local automatically)
DATABASE_URL=postgres://user:pass@localhost:5432/edelfalter

# OpenObserve (OTLP/HTTP). Header example: Authorization=Basic <base64 user:pass>
OTEL_SERVICE_NAME=edelfalter
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic xxx

# Frontend RUM (inlined into the bundle: PUBLIC_*)
PUBLIC_RUM_TOKEN=
PUBLIC_RUM_SITE=localhost:5080
PUBLIC_OTEL_ORGANIZATION=default

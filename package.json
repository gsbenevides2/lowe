{
  "name": "@gsbenevides2/edelfalter",
  "displayName": "Edelfalter",
  "description": "Bun + Elysia + React + Tailwind + shadcn, traced end-to-end with OpenTelemetry/OpenObserve.",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bun run --watch server/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "db:sync": "bun --bun run drizzle-kit push --config server/db/drizzle.config.ts",
    "db:studio": "bun --bun run drizzle-kit studio --config server/db/drizzle.config.ts",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "format": "prettier --write .",
    "test": "bun test && bun test/check-coverage.ts"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
    "@elysia/openapi": "^1.4.16",
    "@elysia/opentelemetry": "^1.4.12",
    "@openobserve/browser-logs": "^0.4.3",
    "@openobserve/browser-rum": "^0.4.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.200.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.200.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.200.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-document-load": "^0.68.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.67.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.200.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "^1.4.30",
    "lucide-react": "^1.54.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@happy-dom/global-registrator": "^20.14.6",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^6",
    "typescript-eslint": "^8.71.1"
  }
}

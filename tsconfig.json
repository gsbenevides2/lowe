{
  "compilerOptions": {
    "target": "ES2021",
    "jsx": "react-jsx",
    "module": "ES2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@server": ["./server/index.ts"],
      "@server/*": ["./server/*"],
      "@public/*": ["./public/*"]
    }
  }
}
